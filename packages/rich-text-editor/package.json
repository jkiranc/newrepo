{
  "name": "react-native-fabric-rich-text",
  "version": "0.1.0",
  "description": "Extensible native (Fabric) rich-text editor for React Native. Register custom HTML tags without touching native code.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/__fixtures__"
  ],
  "keywords": [
    "react-native",
    "rich-text",
    "wysiwyg",
    "editor",
    "html",
    "fabric",
    "new-architecture",
    "ios",
    "android"
  ],
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rimraf lib",
    "prepare": "bob build"
  },
  "dependencies": {
    "htmlparser2": "^9.1.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-builder-bob": "^0.30.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react",
            "esModuleInterop": true,
            "target": "es2019",
            "module": "commonjs",
            "isolatedModules": true
          }
        }
      ]
    }
  },
  "codegenConfig": {
    "name": "RichTextEditorSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.richtexteditor"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      ["commonjs", { "esm": true }],
      ["module", { "esm": true }],
      ["typescript", { "esm": true }]
    ]
  }
}
